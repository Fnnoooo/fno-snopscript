-- 2. Invincible (Forcefield + Delete Hitbox parts + Auto Reset on Disable if Missing)
local invincibleEnabled = false
local hitboxDeleteConnChar = nil
local hitboxDeleteConnLive = nil
local forcefieldConn = nil

local function getLiveFolderCharacter()
    local live = workspace:FindFirstChild("Live")
    if live then
        return live:FindFirstChild(LocalPlayer.Name) or (LocalPlayer.Character and live:FindFirstChild(LocalPlayer.Character.Name))
    end
    return nil
end

local function purgeHitboxesFrom(model)
    if not model then return end
    for _, obj in ipairs(model:GetChildren()) do
        if obj:IsA("BasePart") and string.sub(obj.Name, 1, 7) == "Hitbox_" then
            task.defer(function()
                if obj and obj.Parent then
                    obj:Destroy()
                end
            end)
        end
    end
end

local function countHitboxes(model)
    local count = 0
    if model then
        for _, obj in ipairs(model:GetChildren()) do
            if obj:IsA("BasePart") and string.sub(obj.Name, 1, 7) == "Hitbox_" then
                count += 1
            end
        end
    end
    return count
end

createToggle(bypassTab, "Invincible", false, function(state)
    invincibleEnabled = state

    if state then
        -- Apply "Forcefield"
        local char = LocalPlayer.Character
        if char then
            local ff = char:FindFirstChild("Forcefield")
            if not ff or not ff:IsA("ForceField") then
                local newFf = Instance.new("ForceField")
                newFf.Name = "Forcefield"
                newFf.Visible = false
                newFf.Parent = char
            end
        end

        forcefieldConn = RunService.Heartbeat:Connect(function()
            if invincibleEnabled then
                local c = LocalPlayer.Character
                if c and not c:FindFirstChild("Forcefield") then
                    local newFf = Instance.new("ForceField")
                    newFf.Name = "Forcefield"
                    newFf.Visible = false
                    newFf.Parent = c
                end
            end
        end)

        -- Initial purge
        purgeHitboxesFrom(LocalPlayer.Character)
        purgeHitboxesFrom(getLiveFolderCharacter())

        -- Prevent new hitboxes from adding
        if LocalPlayer.Character then
            hitboxDeleteConnChar = LocalPlayer.Character.ChildAdded:Connect(function(child)
                if invincibleEnabled and child:IsA("BasePart") and string.sub(child.Name, 1, 7) == "Hitbox_" then
                    task.defer(function()
                        if child and child.Parent then child:Destroy() end
                    end)
                end
            end)
        end

        local liveChar = getLiveFolderCharacter()
        if liveChar then
            hitboxDeleteConnLive = liveChar.ChildAdded:Connect(function(child)
                if invincibleEnabled and child:IsA("BasePart") and string.sub(child.Name, 1, 7) == "Hitbox_" then
                    task.defer(function()
                        if child and child.Parent then child:Destroy() end
                    end)
                end
            end)
        end
    else
        -- Clean up listeners and Forcefield
        if hitboxDeleteConnChar then hitboxDeleteConnChar:Disconnect(); hitboxDeleteConnChar = nil end
        if hitboxDeleteConnLive then hitboxDeleteConnLive:Disconnect(); hitboxDeleteConnLive = nil end
        if forcefieldConn then forcefieldConn:Disconnect(); forcefieldConn = nil end

        local char = LocalPlayer.Character
        local ff = char and char:FindFirstChild("Forcefield")
        if ff then ff:Destroy() end

        -- Verify hitboxes restore; if not returned within 1s, reset character
        task.delay(1, function()
            if not invincibleEnabled then
                local currentLive = getLiveFolderCharacter() or LocalPlayer.Character
                local hitboxesNow = countHitboxes(currentLive)
                if hitboxesNow == 0 then
                    local hum = getHumanoid()
                    if hum and hum.Health > 0 then
                        hum:ChangeState(Enum.HumanoidStateType.Dead)
                        hum.Health = 0
                    end
                end
            end
        end)
    end
end)

