    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = page

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingTop = UDim.new(0, 10)
    pagePadding.PaddingLeft = UDim.new(0, 12)
    pagePadding.PaddingRight = UDim.new(0, 12)
    pagePadding.PaddingBottom = UDim.new(0, 10)
    pagePadding.Parent = page

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 20)
    end)

    local btn = Instance.new("TextButton")
    btn.Name = tabName .. "TabBtn"
    btn.Size = UDim2.new(0.86, 0, 0, 32)
    btn.BackgroundColor3 = THEME.Card
    btn.Text = tabName
    btn.TextColor3 = THEME.TextDim
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.Parent = sideBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    tabs[tabName] = page
    tabButtons[tabName] = btn

    btn.MouseButton1Click:Connect(function()
        playSound(SOUNDS.Click, 1.1)
        for name, otherPage in pairs(tabs) do
            local otherBtn = tabButtons[name]
            if name == tabName then
                otherPage.Visible = true
                TweenService:Create(otherBtn, TweenInfo.new(0.15), {
                    BackgroundColor3 = Color3.fromRGB(50, 50, 70),
                    TextColor3 = THEME.TextLight
                }):Play()
            else
                otherPage.Visible = false
                TweenService:Create(otherBtn, TweenInfo.new(0.15), {
                    BackgroundColor3 = THEME.Card,
                    TextColor3 = THEME.TextDim
                }):Play()
            end
        end
    end)

    return page
end

