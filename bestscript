local function setupCounterHighlight(character)
    if not character or not character:IsA("Model") then return end
    if character:GetAttribute("CounterHooked") then return end
    character:SetAttribute("CounterHooked", true)

    local function updateHighlight()
        if not character.Parent then return end
        local hasCounter = highlightActive and (character:FindFirstChild("Counter", true) ~= nil)

        if hasCounter then
            if not character:FindFirstChild("CounterHighlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "CounterHighlight"
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.Parent = character
            end

            if not character:FindFirstChild("CounterTextGui") then
                local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                if head then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "CounterTextGui"
                    bb.Size = UDim2.new(0, 200, 0, 50)
                    bb.StudsOffset = Vector3.new(0, 2.5, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = character
                    bb.Adornee = head

                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = "Death Counter Enabled"
                    txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                    txt.TextStrokeTransparency = 0
                    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    txt.TextScaled = false
                    txt.TextSize = 20
                    txt.Font = Enum.Font.GothamBold
                    txt.Parent = bb
                end
            end
        else
            local hl = character:FindFirstChild("CounterHighlight")
            if hl then hl:Destroy() end

            local bb = character:FindFirstChild("CounterTextGui")
            if bb then bb:Destroy() end
        end
    end

    RunService.Heartbeat:Connect(updateHighlight)
    updateHighlight()

    character.DescendantAdded:Connect(function(child)
        if child.Name == "Counter" then updateHighlight() end
    end)
    character.DescendantRemoving:Connect(function(child)
        if child.Name == "Counter" then task.defer(updateHighlight) end
    end)
end

