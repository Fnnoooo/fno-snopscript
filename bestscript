-- Border Stroke Trackers (Affects ONLY borders/strokes)
local registeredStrokes = {}
local currentThemeMode = "Chromatic"
local staticBorderColor = Color3.fromRGB(145, 120, 255)

local function attachManagedStroke(parentObject, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 1.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parentObject

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 50, 50)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 50)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(50, 255, 120)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(50, 160, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(200, 50, 255))
    })
    gradient.Parent = stroke

    table.insert(registeredStrokes, {stroke = stroke, gradient = gradient})
    return stroke
end

RunService.RenderStepped:Connect(function()
    if currentThemeMode == "Chromatic" then
        local rot = (tick() * 90) % 360
        for _, item in ipairs(registeredStrokes) do
            if item.gradient and item.gradient.Parent then
                item.gradient.Enabled = true
                item.gradient.Rotation = rot
            end
        end
    else
        for _, item in ipairs(registeredStrokes) do
            if item.gradient and item.gradient.Parent then
                item.gradient.Enabled = false
                item.stroke.Color = staticBorderColor
            end
        end
    end
end)

-- Dragging Handler
local function makeDraggable(topbar, object)
    local dragging = false
    local dragInput, dragStart, startPos

    topbar.Active = true
    object.Active = true

    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    topbar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(object, TweenInfo.new(0.06, Enum.EasingStyle.Sine), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

